// Build settings that change by hand, in one place.
//
// MARKETING_VERSION is de versie van de app (CFBundleShortVersionString), de
// release-tag is v$(MARKETING_VERSION). CURRENT_PROJECT_VERSION is het
// buildnummer (CFBundleVersion) en gaat bij elke release omhoog.
MARKETING_VERSION = 0.10.1
CURRENT_PROJECT_VERSION = 16

// Nooit wijzigen: instellingen, meldingstoestemming en Keychain-tokens van
// bestaande gebruikers hangen aan deze bundle id.
PRODUCT_BUNDLE_IDENTIFIER = nl.torrisi.pullwatch

// De eigenaar van de releases op GitHub (github.com/<eigenaar>/pullwatch): de updatecheck en
// Sparkle lezen daar de nieuwste release en zijn appcast.xml. Een fork die eigen releases
// maakt, zet hier zijn eigen naam; verder verschilt er niets.
PW_RELEASES_OWNER = alessandro823

// Swift voor het app-target: de app is UI met één model op de main actor, dus alles is
// standaard @MainActor (Xcode's standaard voor nieuwe apps sinds Swift 6.2). PullwatchKit
// blijft standaard nonisolated. De taalinstellingen voor alle targets staan op projectniveau.
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
