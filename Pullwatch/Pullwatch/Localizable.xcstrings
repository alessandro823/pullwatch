    "Pullwatch leest de runtimes en packages van de repo's die je volgt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch liest die Runtimes und Pakete der Repos, denen du folgst."
          }
        },
        "en": {
