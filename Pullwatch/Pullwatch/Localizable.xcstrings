    "Een schakelaar omzetten start geen check. Wat eerder van een bron kwam die nu uit staat, telt niet meer als actueel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schalter startet keine Prüfung. Was früher von einer Quelle kam, die jetzt aus ist, gilt nicht mehr als aktuell."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flipping a switch does not start a check. What came earlier from a source that is now off no longer counts as current."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Basculer un interrupteur ne lance pas de vérification. Ce qui venait d’une source désormais désactivée n’est plus considéré comme à jour."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
