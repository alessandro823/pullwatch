    "Zonder tonen staan drafts nergens en komt een draft binnen zodra hij klaar is voor review. Verbergen geldt overal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Anzeigen erscheinen Entwürfe nirgends, und ein Entwurf kommt an, sobald er bereit zum Review ist. Ausblenden gilt überall."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without showing, drafts appear nowhere and a draft arrives once it is ready for review. Hiding applies everywhere."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans affichage, les brouillons n’apparaissent nulle part et un brouillon arrive dès qu’il est prêt pour la revue. Masquer s’applique partout."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder tonen staan drafts nergens en komt een draft binnen zodra hij klaar is voor review. Verbergen geldt overal."
          }
        }
      }
    },
