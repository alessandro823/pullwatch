      }
    },
    "Een melding als de checks (CI) van een open pull request van jou mislukken, ook als je eigen PR's verborgen zijn": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Mitteilung, wenn die Checks (CI) eines deiner offenen Pull Requests fehlschlagen, auch wenn deine eigenen PRs ausgeblendet sind"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A notification when the checks (CI) of an open pull request of yours fail, also when your own PRs are hidden"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une notification quand les checks (CI) d'une de vos pull requests ouvertes échouent, même si vos propres PR sont masquées"
          }
        }
      }
    },
    "Een melding als een open pull request uit de merge queue of merge train gaat, of auto-merge of auto-complete uit gaat, zonder dat hij mergede": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Mitteilung, wenn ein offener Pull Request die Merge Queue oder den Merge Train verlässt oder Auto-Merge bzw. Auto-Complete verliert, ohne gemergt zu sein"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A notification when an open pull request leaves the merge queue or merge train, or loses auto-merge or auto-complete, without having merged"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une notification quand une pull request ouverte quitte la merge queue ou le merge train, ou perd l’auto-merge ou l’auto-complete, sans avoir été fusionnée"
          }
        }
      }
    },
    "Een melding als een package dat een gevolgde repo publiceert een nieuwe versie heeft (het onderdeel Packages)": {
      "localizations": {
        "de": {
          "stringUnit": {
