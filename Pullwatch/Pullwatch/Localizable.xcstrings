    "Pullwatch downloadt een update op de achtergrond en installeert hem als je de app afsluit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch lädt ein Update im Hintergrund und installiert es, wenn du die App beendest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch downloads an update in the background and installs it when you quit the app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch télécharge une mise à jour en arrière-plan et l’installe quand vous quittez l’app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch downloadt een update op de achtergrond en installeert hem als je de app afsluit."
          }
        }
      }
    },
    "Pullwatch draait in de menubalk, rechtsboven naast de klok. Het heeft geen icoon in het Dock en geen venster zolang je er niets mee doet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch läuft in der Menüleiste, oben rechts neben der Uhr. Es hat kein Symbol im Dock und kein Fenster, solange du es nicht benutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch runs in the menu bar, at the top right next to the clock. It has no icon in the Dock and no window until you use it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pullwatch se trouve dans la barre des menus, en haut à droite près de l’horloge. Il n’a pas d’icône dans le Dock ni de fenêtre tant que vous ne l’utilisez pas."
          }
        }
      }
    },
    "Pullwatch haalt de PR's op van %@.": {
      "comment": "Accountnaam, bv. @octocat op GitHub",
      "localizations": {
        "de": {
          "stringUnit": {
