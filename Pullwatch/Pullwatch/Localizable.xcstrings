            "state": "translated",
            "value": "Update %@ to %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour %@ vers %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "new",
            "value": "Werk %1$@ bij naar %2$@"
          }
        }
      }
    },
    "Werk %@ bij naar %@; dat valt binnen het bereik, alleen de lockfile verandert": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiere %1$@ auf %2$@; das liegt im Bereich, nur die Lockfile ändert sich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update %1$@ to %2$@; that is within range, only the lockfile changes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour %1$@ vers %2$@ ; c’est dans la plage, seul le fichier lock change"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "new",
            "value": "Werk %1$@ bij naar %2$@; dat valt binnen het bereik, alleen de lockfile verandert"
          }
        }
      }
    },
    "Werk %@ bij naar %@; dat valt buiten het bereik, pas het manifest aan": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisiere %1$@ auf %2$@; das liegt außerhalb des Bereichs, ändere das Manifest"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update %1$@ to %2$@; that is outside the range, change the manifest"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour %1$@ vers %2$@ ; c’est hors de la plage, modifiez le manifeste"
          }
        },
        "nl": {
