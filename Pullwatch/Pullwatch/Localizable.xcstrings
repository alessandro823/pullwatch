    "Uit: Pullwatch haalt niets op voor dit account en stuurt er geen meldingen over. Wat je volgt blijft bewaard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus: Pullwatch ruft für dieses Konto nichts ab und sendet keine Mitteilungen dazu. Was du folgst, bleibt gespeichert."
          }
        },
        "en": {
          "stringUnit": {
