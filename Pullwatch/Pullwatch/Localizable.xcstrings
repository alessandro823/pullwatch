    "Een losse repository volgen, ook een openbare van een andere organisatie": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einem einzelnen Repository folgen, auch einem öffentlichen einer anderen Organisation"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch a single repository, also a public one of another organisation"
          }
        },
