      }
    },
    "Leest met gh als %@, niet als %@: dat werkt als %@ de packages van de gevolgde eigenaren mag zien.": {
      "comment": "Het gh-account, het account van de GitHub App, nog eens het gh-account",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest mit gh als %1$@, nicht als %2$@: Das funktioniert, wenn %3$@ die Pakete der gefolgten Eigentümer sehen darf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads with gh as %1$@, not as %2$@: this works when %3$@ can see the packages of the followed owners."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit avec gh en tant que %1$@, pas en tant que %2$@ : cela fonctionne si %3$@ peut voir les paquets des propriétaires suivis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leest met gh als %1$@, niet als %2$@: dat werkt als %3$@ de packages van de gevolgde eigenaren mag zien."
          }
        }
      }
    },
    "Leest met gh als %@.": {
