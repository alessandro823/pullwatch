    },
    "De nieuwste versie die nu kan, met wat een ouder, peer of runtime toelaat": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neueste Version, die jetzt geht, mit dem, was ein Elternpaket, Peer oder die Runtime erlaubt"
